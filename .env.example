# ==============================================================================
# ATS Resume Builder - Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Authentication
# Generate a secure 32+ character key: openssl rand -hex 32
SECRET_KEY=replace_with_super_secret_jwt_hmac_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Supabase Integration (Leave empty to use built-in JWT authentication)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database Configuration
# Local Development SQLite default: sqlite:///./ats_resumes.db
# Production PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/ats_resume_db
DATABASE_URL=sqlite:///./ats_resumes.db

# AI Provider Configuration (Optional - heuristic fallback operates automatically without key)
# Supported providers: gemini | openai | fallback
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
